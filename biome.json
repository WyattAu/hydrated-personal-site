{
  "$schema": "https://biomejs.dev/schemas/1.0.0/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedLabels": "warn",
        "noUnusedPrivateClassMembers": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "complexity": {
        "noForEach": "warn"
      },
      "a11y": {
        "useAltText": "error",
        "useValidAnchor": "error",
        "useButtonType": "error",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "useAriaPropsForRole": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".astro",
      ".turbo",
      ".wrangler",
      "bun.lock",
      "coverage",
      "playwright-report",
      "test-results",
      "packages/widgets/pkg",
      "packages/widgets/target",
      "apps/site/public/wasm",
      "apps/site/public/wasm-anim.js",
      "apps/site/public/wasm-v2",
      "apps/site/public/wasm-v3",
      "apps/site/public/wasm-v4"
    ]
  },
  "overrides": [
    {
      "include": ["*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "include": ["*.test.ts", "*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "noForEach": "off"
          }
        }
      }
    },
    {
      "include": ["apps/site/src/components/solid/quant/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
