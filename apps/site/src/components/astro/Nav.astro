---
const navItems = [
  { label: 'PROJECTS', href: '/projects' },
  { label: 'DOSSIER', href: '/dossier' },
  { label: 'WORLD', href: '/world' },
  { label: 'DOCS', href: '/docs' },
  { label: 'ETF', href: '/etf' },
  { label: 'GUESTBOOK', href: '/guestbook' },
  { label: 'USES', href: '/uses' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href) || currentPath === `${href}/`;
}
---

<nav
  class="fixed top-0 left-0 right-0 border-b"
  style="
    z-index: var(--z-nav);
    border-color: var(--border);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    background: var(--nav-bg);
  "
  role="navigation"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between h-14 px-6 md:px-12">
    <a
      href="/"
      class="font-mono text-xs font-bold tracking-widest uppercase"
      style="color: var(--accent);"
    >
      WYATT_AU
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`nav-text transition-all ${
            isActive(item.href)
              ? 'opacity-100'
              : 'opacity-50 hover:opacity-80'
          }`}
          style={isActive(item.href)
            ? `color: var(--accent);`
            : `color: var(--text-secondary);`
          }
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
          {isActive(item.href) && (
            <span
              class="block h-px mt-0.5"
              style="background: var(--accent);"
              aria-hidden="true"
            />
          )}
        </a>
      ))}
    </div>

    <!-- Mobile hamburger -->
    <button
      class="md:hidden flex flex-col gap-1 p-2"
      aria-label="Toggle menu"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-5 h-px transition-all duration-200" id="hamburger-line-1" style="background: var(--text-primary);"></span>
      <span class="block w-5 h-px transition-all duration-200" id="hamburger-line-2" style="background: var(--text-primary);"></span>
      <span class="block w-3 h-px transition-all duration-200" id="hamburger-line-3" style="background: var(--text-primary);"></span>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t"
    style="border-color: var(--border); background: var(--nav-bg-solid); backdrop-filter: blur(12px);"
  >
    <div class="flex flex-col px-6 py-4 gap-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`nav-text block py-2 transition-all ${
            isActive(item.href)
              ? 'opacity-100'
              : 'opacity-50 hover:opacity-80'
          }`}
          style={isActive(item.href)
            ? `color: var(--accent);`
            : `color: var(--text-secondary);`
          }
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', function () {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');

      const line1 = document.getElementById('hamburger-line-1');
      const line2 = document.getElementById('hamburger-line-2');
      const line3 = document.getElementById('hamburger-line-3');

      if (!expanded) {
        if (line1) line1.style.transform = 'rotate(45deg) translate(2px, 2px)';
        if (line2) line2.style.opacity = '0';
        if (line3) { line3.style.transform = 'rotate(-45deg) translate(2px, -2px)'; line3.style.width = '1.25rem'; }
      } else {
        if (line1) line1.style.transform = '';
        if (line2) line2.style.opacity = '';
        if (line3) { line3.style.transform = ''; line3.style.width = ''; }
      }
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        var line1 = document.getElementById('hamburger-line-1');
        var line2 = document.getElementById('hamburger-line-2');
        var line3 = document.getElementById('hamburger-line-3');
        if (line1) line1.style.transform = '';
        if (line2) line2.style.opacity = '';
        if (line3) { line3.style.transform = ''; line3.style.width = ''; }
      });
    });
  });
</script>
