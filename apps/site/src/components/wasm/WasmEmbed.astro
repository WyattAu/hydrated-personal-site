---
interface Props {
  widget: string;
  width?: number;
  height?: number;
  class?: string;
  dataEndpoint?: string;
  dataInterval?: number;
}

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const {
  widget,
  width = 800,
  height = 400,
  class: className = '',
  dataEndpoint = '',
  dataInterval = 0,
} = Astro.props;
const widgetId = `wasm-${widget}-${Math.random().toString(36).slice(2, 8)}`;
const canvasId = `${widgetId}-canvas`;
const ariaLabel = `${widget.replace(/_/g, ' ')} widget`;
---

<div
  id={widgetId}
  class={`wasm-embed ${className}`}
  data-widget={widget}
  data-width={width}
  data-height={height}
  data-endpoint={dataEndpoint}
  data-interval={dataInterval}
  style={`width: ${width}px; height: ${height}px;`}
>
  <canvas
    id={canvasId}
    width={width}
    height={height}
    tabindex="0"
    role="application"
    aria-label={ariaLabel}
    style="display: block; width: 100%; height: 100%; outline: none;"
  ></canvas>
</div>

<script is:inline src="/wasm-anim.js"></script>

<script is:inline>
  (function () {
    if (window.__wasmInit) return;
    window.__wasmInit = true;

    function initWasmEmbeds() {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              if (el.dataset.wasmReady) return;
              el.dataset.wasmReady = '1';

              var widget = el.dataset.widget;
              var w = parseInt(el.dataset.width || '800', 10);
              var h = parseInt(el.dataset.height || '400', 10);
              var canvasId = el.id + '-canvas';
              var endpoint = el.dataset.endpoint || '';
              var interval = parseInt(el.dataset.interval || '0', 10);

              var wasmPath = '/wasm/hw_1781798679.js';
              import(wasmPath)
                .then(async function (mod) {
                  await mod.default();
                  var createFn = mod['create_' + widget];
                  if (createFn) {
                    var canvasEl = document.getElementById(canvasId);
                    if (!canvasEl) {
                      throw new Error('Canvas element ' + canvasId + ' not found in DOM');
                    }
                    createFn(canvasId, w, h);

                    // Fetch data and call update function if endpoint is specified
                    var updateFn = mod['update_' + widget];
                    if (endpoint && updateFn) {
                      function fetchDataAndUpdate() {
                        fetch(endpoint)
                          .then(function (res) {
                            if (!res.ok) throw new Error('Data fetch failed');
                            return res.json();
                          })
                          .then(function (data) {
                            try {
                              updateFn(canvasId, w, h, JSON.stringify(data));
                            } catch (e) {
                              console.warn('WASM update failed for ' + widget + ':', e);
                            }
                          })
                          .catch(function (e) {
                            console.warn('WASM data fetch failed for ' + widget + ':', e);
                          });
                      }
                      fetchDataAndUpdate();
                      if (interval > 0) {
                        el.__wasmDataInterval = setInterval(fetchDataAndUpdate, interval);
                      }
                    }

                    // Start animation loop after initial render
                    if (window.__wasmAnim) {
                      el.__wasmAnimLoop = window.__wasmAnim.startAnimationLoop(
                        mod,
                        widget,
                        canvasId,
                        w,
                        h
                      );
                    }
                  } else {
                    throw new Error('Widget function create_' + widget + ' not found');
                  }
                })
                .catch(function (err) {
                  el.innerHTML =
                    '<div class="wasm-error">' +
                    '<p>Failed to load widget.</p>' +
                    '<p class="wasm-error-detail">' + err.message + '</p>' +
                    '</div>';
                  console.error('WASM widget "' + widget + '" failed:', err);
                });

              observer.unobserve(el);
            }
          });
        },
        { rootMargin: '200px' }
      );

      document.querySelectorAll('.wasm-embed').forEach(function (el) {
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWasmEmbeds);
    } else {
      initWasmEmbeds();
    }
  })();
</script>

<style>
  .wasm-embed {
    position: relative;
    border: 1px solid #1a1a2e;
    border-radius: 4px;
    overflow: hidden;
    background: #0a0a0a;
  }

  .wasm-skeleton {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    gap: 12px;
  }

  .skeleton-pulse {
    width: 60%;
    height: 8px;
    background: linear-gradient(90deg, #1a1a2e 25%, #2a2a4e 50%, #1a1a2e 75%);
    background-size: 200% 100%;
    animation: pulse 1.5s ease-in-out infinite;
    border-radius: 4px;
  }

  .skeleton-text {
    color: #666;
    font-size: 12px;
    font-family: monospace;
  }

  .wasm-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #ff6b6b;
    font-family: monospace;
    font-size: 13px;
    text-align: center;
    padding: 16px;
  }

  .wasm-error-detail {
    color: #888;
    font-size: 11px;
    margin-top: 8px;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }
</style>
