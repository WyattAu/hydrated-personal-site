---
import { SEO } from 'astro-seo';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = 'Wyatt Au — Backend Engineer & Systems Architect',
  description = 'Building deterministic infrastructure and high-performance systems. Currently bootstrapping QuestHive.',
  ogImage = '/og-image.png',
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = 'wyatt_au';
const siteUrl = 'https://wyattau.com';

// JSON-LD Schemas
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Wyatt Au',
  jobTitle: 'Backend Engineer & Systems Architect',
  url: siteUrl,
  email: 'wyatt_au@protonmail.com',
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'GB',
    },
  },
  sameAs: [
    'https://github.com/WyattAu',
    'https://forgejo.wyattau.com/wyatt_admin',
    'https://x.com/_WyattAu_',
  ],
  knowsAbout: [
    'Systems Programming',
    'Rust',
    'WebAssembly',
    'Infrastructure Engineering',
    'DevOps',
    'Cloud Architecture',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'QuestHive',
    url: 'https://questhive.io',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wyatt Au',
  url: siteUrl,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Wyatt Au',
  },
  publisher: {
    '@type': 'Person',
    name: 'Wyatt Au',
  },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonical,
  inLanguage: 'en-GB',
};
---

<!DOCTYPE html>
<html lang="en" data-theme="midnight-navy">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: type,
          url: canonical,
          image: `${siteUrl}${ogImage}`,
        },
        optional: {
          siteName: siteName,
          locale: 'en_GB',
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: `${siteUrl}${ogImage}`,
        creator: '@_WyattAu_',
      }}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050505" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="Wyatt Au" />

    <!-- Content Security Policy (meta tag for prerendered pages) -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://plausible.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://plausible.io https://www.okx.com https://api.kraken.com https://api.bybit.com https://api.mempool.space https://api.alternative.me https://query2.finance.yahoo.com https://hydrated-worker.wyatt-au.workers.dev https://challenges.cloudflare.com https://raw.githubusercontent.com https://api.worldbank.org https://restcountries.com https://api.github.com https://fred.stlouisfed.org https://services.swpc.noaa.gov; base-uri 'self'; form-action 'self'" />

    <!-- Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

    <!-- Theme init (prevent flash) -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || 'midnight-navy';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Service Worker Registration (production only) -->
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>

    <!-- Plausible Analytics -->
    <script defer data-domain="wyattau.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <slot />

    <!-- Cinematic overlays -->
    <div class="vignette" aria-hidden="true"></div>
    <div class="film-grain" aria-hidden="true"></div>
  </body>
</html>
<!-- csp v4 -->
