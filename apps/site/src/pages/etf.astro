---
import Footer from '../components/astro/Footer.astro';
import Nav from '../components/astro/Nav.astro';
import AppErrorBoundary from '../components/solid/ErrorBoundary';
import EtfApp from '../components/solid/EtfApp';
import ThemeToggle from '../components/solid/ThemeToggle';
import EtfDrawdownChart from '../components/solid/quant/EtfDrawdownChart';
import EtfMonteCarlo from '../components/solid/quant/EtfMonteCarlo';
import EtfRiskReturnScatter from '../components/solid/quant/EtfRiskReturnScatter';
import EtfVaR from '../components/solid/quant/EtfVaR';
import WasmEmbed from '../components/wasm/WasmEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/base.css';
---

<BaseLayout
  title="ETF Intelligence — Wyatt Au"
  description="ETF database with allocation analysis, portfolio comparison, correlation matrix, and performance metrics."
>
  <Nav />

    <main id="main-content" class="pt-32">
    <section class="px-6 md:px-12 lg:px-24 pb-6">
      <p class="label mb-2" style="color: var(--accent);">ETF INTELLIGENCE</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-1">ETF Database & Analysis</h1>
      <p class="text-sm" style="color: var(--text-secondary);">Search 89 ETFs, compare allocations, and analyze correlations.</p>
    </section>

    <section class="px-6 md:px-12 lg:px-24 pb-12">
      <AppErrorBoundary client:load>
        <EtfApp client:load />
      </AppErrorBoundary>
    </section>

    <!-- WASM Correlation Network -->
    <section class="py-12 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);">WASM ANALYTICS</p>
      <h2 class="text-xl md:text-2xl font-bold mb-4">Correlation Network</h2>
      <p class="mb-8 text-sm" style="color: var(--text-secondary); max-width: 640px;">
        Interactive network graph showing ETF correlations. Edge width represents correlation strength,
        color indicates positive (cyan) or negative (red) relationships.
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">Correlation Network</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Force-directed graph of ETF correlations based on daily returns.</p>
          <WasmEmbed widget="correlation" width={500} height={400} />
        </div>
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">How It Works</p>
          <div class="space-y-3 text-sm" style="color: var(--text-secondary);">
            <p>
              <span style="color: var(--accent);">Node size</span> represents the ETF's market capitalization.
            </p>
            <p>
              <span style="color: var(--accent);">Edge width</span> represents the absolute correlation coefficient between two ETFs.
            </p>
            <p>
              <span style="color: var(--accent);">Edge color</span> — cyan for positive correlation, red for negative correlation.
            </p>
            <p>
              <span style="color: var(--accent);">Drag nodes</span> to rearrange the layout. Hover for details.
            </p>
            <p class="mt-4 font-mono text-[10px]" style="color: var(--text-secondary);">
              Computed client-side from 1Y daily returns using WASM-accelerated linear algebra.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ETF Quant Analytics -->
    <section class="py-12 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-2" style="color: var(--accent);">QUANT ANALYTICS</p>
      <h2 class="text-xl md:text-2xl font-bold mb-1">ETF Risk & Performance Engine</h2>
      <p class="mb-6 text-sm" style="color: var(--text-secondary);">All computations run in Rust/WASM on your CPU. Data from Yahoo Finance.</p>

      <!-- Row 1: Risk-Return Scatter + Monte Carlo -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <EtfRiskReturnScatter client:load />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <EtfMonteCarlo client:load symbol="SPY" />
          </AppErrorBoundary>
        </div>
      </div>

      <!-- Row 2: Drawdown + VaR -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <EtfDrawdownChart client:load symbol="SPY" />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <EtfVaR client:load symbol="SPY" />
          </AppErrorBoundary>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ThemeToggle client:load />
</BaseLayout>
