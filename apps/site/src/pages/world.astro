---
import Footer from '../components/astro/Footer.astro';
import Nav from '../components/astro/Nav.astro';
import DataPanels from '../components/solid/DataPanels';
import AppErrorBoundary from '../components/solid/ErrorBoundary';
import MetricCards from '../components/solid/MetricCards';
import PriceChart from '../components/solid/PriceChart';
import ScatterPlots from '../components/solid/ScatterPlots';
import StaleIndicator from '../components/solid/StaleIndicator';
import ThemeToggle from '../components/solid/ThemeToggle';
import WorldMap from '../components/solid/WorldMap';
import CorrelationNetwork from '../components/solid/quant/CorrelationNetwork';
import EfficientFrontier from '../components/solid/quant/EfficientFrontier';
import FundingRateHeatmap from '../components/solid/quant/FundingRateHeatmap';
import GreeksDashboard from '../components/solid/quant/GreeksDashboard';
import MonteCarloFan from '../components/solid/quant/MonteCarloFan';
import OptionsPayoff from '../components/solid/quant/OptionsPayoff';
import RiskMetrics from '../components/solid/quant/RiskMetrics';
import RollingCorrelationHeatmap from '../components/solid/quant/RollingCorrelationHeatmap';
import VolatilityForecast from '../components/solid/quant/VolatilityForecast';
import YieldCurveChart from '../components/solid/quant/YieldCurveChart';
import WasmEmbed from '../components/wasm/WasmEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/base.css';
---

<BaseLayout
  title="World Monitor — Wyatt Au"
  description="Real-time world intelligence monitor: earthquakes, crypto prices, market data, LLM benchmarks, and trending tech."
>
  <Nav />

  <main id="main-content" class="pt-28">
    <section class="px-6 md:px-12 lg:px-24 pb-6">
      <p class="label mb-2" style="color: var(--accent);">WORLD MONITOR</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-1">Intelligence Dashboard</h1>
      <p class="text-sm" style="color: var(--text-secondary);">Live data feeds, market metrics, and global monitoring.</p>
    </section>

    <!-- Map -->
    <section class="w-full border-y" style="border-color: var(--border); height: 50vh; min-height: 360px;">
      <AppErrorBoundary client:load>
        <WorldMap client:load />
      </AppErrorBoundary>
    </section>

    <!-- Metric Cards -->
    <section class="px-6 md:px-12 lg:px-24 py-6">
      <MetricCards client:load />
    </section>

    <!-- Price Chart -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <AppErrorBoundary client:load>
        <PriceChart client:load symbol="^GSPC" title="MARKET OVERVIEW" />
      </AppErrorBoundary>
    </section>

    <!-- WASM Finance Widgets -->
    <section class="py-12 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);">WASM ANALYTICS</p>
      <h2 class="text-xl md:text-2xl font-bold mb-4">Interactive Market Tools</h2>
      <p class="mb-8 text-sm" style="color: var(--text-secondary);">Client-side analytics powered by WebAssembly.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">Order Book</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Bitcoin mempool fee structure visualised as a depth chart.</p>
          <WasmEmbed widget="order_book" width={380} height={300} dataEndpoint="/api/mempool" dataInterval={60000} />
        </div>
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">Market Treemap</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Crypto asset treemap. Cell size scales with trading volume.</p>
          <WasmEmbed widget="treemap" width={380} height={300} dataEndpoint="/api/crypto-ticker" dataInterval={30000} />
        </div>
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">BTC Health</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Mempool count and recommended fees from mempool.space.</p>
          <WasmEmbed widget="btc_health" width={380} height={300} dataEndpoint="/api/mempool" dataInterval={60000} />
        </div>
      </div>
    </section>

    <!-- Data Panels Grid -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <DataPanels client:load />
    </section>

    <!-- Scatter Plots -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <ScatterPlots client:load />
    </section>

    <!-- Quant Dashboard -->
    <section class="px-6 md:px-12 lg:px-24 py-8 border-t" style="border-color: var(--border);">
      <p class="label mb-2" style="color: var(--accent);">QUANT ANALYTICS</p>
      <h2 class="text-xl md:text-2xl font-bold mb-1">Client-Side Quantitative Engine</h2>
      <p class="mb-6 text-sm" style="color: var(--text-secondary);">All computations run in Rust/WASM on your CPU. Zero server-side math.</p>

      <!-- Row 1: Monte Carlo + GARCH -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <MonteCarloFan client:load symbol="BTCUSDT" />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <VolatilityForecast client:load symbol="BTCUSDT" />
          </AppErrorBoundary>
        </div>
      </div>

      <!-- Row 2: Efficient Frontier + Greeks -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <EfficientFrontier client:load />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <GreeksDashboard client:load />
          </AppErrorBoundary>
        </div>
      </div>

      <!-- Row 3: VaR + Options Payoff -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <RiskMetrics client:load symbol="BTCUSDT" />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <OptionsPayoff client:load />
          </AppErrorBoundary>
        </div>
      </div>

      <!-- Row 4: Correlation Network + Yield Curve -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <CorrelationNetwork client:load />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <YieldCurveChart client:load />
          </AppErrorBoundary>
        </div>
      </div>

      <!-- Row 5: Rolling Correlation + Funding Rates -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <RollingCorrelationHeatmap client:load />
          </AppErrorBoundary>
        </div>
        <div class="p-4 border" style="border-color: var(--border); background: var(--bg-card);">
          <AppErrorBoundary client:load>
            <FundingRateHeatmap client:load />
          </AppErrorBoundary>
        </div>
      </div>
    </section>

    <!-- Stale Indicator -->
    <section class="px-6 md:px-12 lg:px-24 py-4 pb-12">
      <StaleIndicator client:load />
    </section>
  </main>

  <Footer />
  <ThemeToggle client:load />
</BaseLayout>
