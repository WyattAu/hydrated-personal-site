---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import ThemeToggle from '../components/solid/ThemeToggle';
import WorldMap from '../components/solid/WorldMap';
import MetricCards from '../components/solid/MetricCards';
import PriceChart from '../components/solid/PriceChart';
import DataPanels from '../components/solid/DataPanels';
import ScatterPlots from '../components/solid/ScatterPlots';
import StaleIndicator from '../components/solid/StaleIndicator';
import AppErrorBoundary from '../components/solid/ErrorBoundary';
import WasmEmbed from '../components/wasm/WasmEmbed.astro';
import '../styles/base.css';
---

<BaseLayout
  title="World Monitor — Wyatt Au"
  description="Real-time world intelligence monitor: earthquakes, crypto prices, market data, LLM benchmarks, and trending tech."
>
  <Nav />

  <main id="main-content" class="pt-24">
    <section class="px-6 md:px-12 lg:px-24 pb-6">
      <p class="label mb-2" style="color: var(--accent);">WORLD MONITOR</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-1">Intelligence Dashboard</h1>
      <p class="text-sm" style="color: var(--text-secondary);">Live data feeds, market metrics, and global monitoring.</p>
    </section>

    <!-- Map -->
    <section class="w-full border-y" style="border-color: var(--border); height: 50vh; min-height: 360px;">
      <AppErrorBoundary client:load>
        <WorldMap client:load />
      </AppErrorBoundary>
    </section>

    <!-- Metric Cards -->
    <section class="px-6 md:px-12 lg:px-24 py-6">
      <MetricCards client:load />
    </section>

    <!-- Price Chart -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <AppErrorBoundary client:load>
        <PriceChart client:load symbol="^GSPC" title="S&P 500" />
      </AppErrorBoundary>
    </section>

    <!-- WASM Finance Widgets -->
    <section class="py-12 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);">WASM ANALYTICS</p>
      <h2 class="text-xl md:text-2xl font-bold mb-4">Interactive Market Tools</h2>
      <p class="mb-8 text-sm" style="color: var(--text-secondary);">Client-side analytics powered by WebAssembly.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">Order Book</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Real-time order book visualization with depth analysis.</p>
          <WasmEmbed widget="order_book" width={400} height={300} dataEndpoint="/api/mempool" dataInterval={60000} />
        </div>
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">Market Treemap</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Sector allocation treemap with size representing market cap.</p>
          <WasmEmbed widget="treemap" width={400} height={300} dataEndpoint="/api/crypto-ticker" dataInterval={30000} />
        </div>
        <div class="p-6 border" style="border-color: var(--border); background: var(--bg-card);">
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">BTC Health</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Mempool fees, hashrate, and network health indicators.</p>
          <WasmEmbed widget="btc_health" width={400} height={300} dataEndpoint="/api/mempool" dataInterval={60000} />
        </div>
      </div>
    </section>

    <!-- Data Panels Grid -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <DataPanels client:load />
    </section>

    <!-- Scatter Plots -->
    <section class="px-6 md:px-12 lg:px-24 py-4">
      <ScatterPlots client:load />
    </section>

    <!-- Stale Indicator -->
    <section class="px-6 md:px-12 lg:px-24 py-4 pb-12">
      <StaleIndicator client:load />
    </section>
  </main>

  <Footer />
  <ThemeToggle client:load />
</BaseLayout>
