---
import Footer from '../../components/astro/Footer.astro';
import Nav from '../../components/astro/Nav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const studies = [
  {
    slug: 'g1-storm-2026-11-19',
    label: 'EVENT REPORT · FIRST-HAND',
    title: 'The November 19 2026 G1 storm, captured by this site\u2019s own monitor',
    summary:
      'Kp 5.0, SWPC K05A alert, and a 20%→55% aurora-probability envelope recorded at 30-minute cadence by the /world monitor, the site observed its own first storm, and the correlation against the official index is r = 0.79.',
  },
  {
    slug: 'etf-allocation-study',
    label: 'DATA STUDY · 89 FUNDS',
    title: 'What 89 ETFs\u2019 top holdings reveal about index concentration',
    summary:
      'NVIDIA carries the heaviest average top-10 weight in the database (8.58%) and the Magnificent 7 appear in roughly one in five funds each. Sector tilts invert outside the US: Technology-first at home, Financials-first abroad. Recomputed from the keyless dataset at build time.',
  },
];

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Insights, original data studies and first-hand event reports',
  description:
    'Original analyses built from wyattau.com\u2019s own datasets and instrumentation: ETF allocation structure and space-weather event captures.',
  url: 'https://wyattau.com/insights',
  isAccessibleForFree: true,
  hasPart: studies.map((s) => ({
    '@type': 'Article',
    headline: s.title,
    url: `https://wyattau.com/insights/${s.slug}`,
  })),
};
---

<BaseLayout
  lastModified="2026-11-19"
  title="Insights, Original Data Studies & Event Reports, Wyatt Au"
  ogImage="/og/insights.png"
  description="Original analyses from own instrumentation and datasets: first-hand space-weather event captures and ETF allocation studies, recomputed from keyless downloads at build time."
  faq={[
    {
      q: 'What is published under /insights?',
      a: 'Two kinds of original analysis: first-hand event reports captured by this site\u2019s own instrumentation (space weather), and data studies computed from the keyless dataset downloads (ETF allocations).',
    },
    {
      q: 'Why trust these numbers?',
      a: 'Every figure is reproducible: event data comes from the site\u2019s public 48-point monitor history, study aggregates recompute at build time from /data/etf-database.json, and each page documents its method.',
    },
  ]}
>
  <Nav />
  <main id="main-content" class="pt-32">
    <section class="py-16 px-6 md:px-12 lg:px-24">
      <p class="label mb-6">Insights</p>
      <h1 class="mb-4" style="font-family: var(--font-display, 'Fraunces', Georgia, serif); font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.1; mb-4"">
        Original data, first-hand observations
      </h1>
      <p class="text-lg" style="color: var(--text-secondary); max-width: 760px;">
        Answer: analyses nobody else can publish, event reports captured by this
        site's own instrumentation, and studies recomputed at build time from
        keyless dataset downloads. Every number is reproducible from a public
        source, and every page documents its method.
      </p>
    </section>

    <section class="py-8 px-6 md:px-12 lg:px-24 pb-16 space-y-6">
      {studies.map((s) => (
        <a href={`/insights/${s.slug}`} class="block border p-6 hover:opacity-90 transition-opacity" style="border-color: var(--border); background: var(--bg-card);">
          <p class="label mb-2">{s.label}</p>
          <h2 class="text-xl font-bold mb-2">{s.title}</h2>
          <p class="text-sm" style="color: var(--text-secondary);">{s.summary}</p>
          <p class="font-mono text-xs mt-4" style="color: var(--accent);">Read the report ↗</p>
        </a>
      ))}

      <div class="border p-6" style="border-color: var(--border);">
        <p class="label mb-2">Source Data</p>
        <p class="text-sm" style="color: var(--text-secondary); max-width: 720px;">
          The raw material lives in the keyless downloads: the
          <a href="/data" class="hover:underline" style="color: var(--accent);">dataset catalog</a>
          (89-fund ETF database, transparency reports) and the live
          <a href="/world" class="hover:underline" style="color: var(--accent);">OSINT dashboards</a>
          whose 30-minute history feeds the event reports. New studies are added
          as events happen and as the datasets grow.
        </p>
      </div>

      <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
    </section>
  </main>
  <Footer />
</BaseLayout>
