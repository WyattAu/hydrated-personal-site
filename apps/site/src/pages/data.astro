---
import Footer from '../components/astro/Footer.astro';
import Nav from '../components/astro/Nav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Wyatt Au reference datasets (ETF database + site SEO audits)',
  description:
    'Keyless JSON downloads powering the dashboards: an 89-fund ETF database with sector/region allocations and top holdings, plus site-wide and per-page SEO audit results.',
  url: 'https://wyattau.com/data',
  creator: { '@type': 'Person', name: 'Wyatt Au', url: 'https://wyattau.com' },
  dateModified: '2026-11-18',
  isAccessibleForFree: true,
  license: 'https://wyattau.com/data',
  keywords: ['ETF', 'dataset', 'allocations', 'holdings', 'SEO audit', 'JSON'],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://wyattau.com/data/etf-database.json',
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://wyattau.com/data/seo-audit.json',
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://wyattau.com/data/seo-pages.json',
    },
  ],
};
---

<BaseLayout
  title="World Data — Wyatt Au"
  ogImage="/og/data.png"
  description="Reference datasets powering the dashboards: the 89-fund ETF database with allocations and holdings, plus site SEO audit results. Keyless JSON, free to download."
  faq={[
    {
      q: 'What datasets are available?',
      a: "The 89-fund ETF database (tickers, sector/region allocations, top holdings) and this site's own SEO audit results — both as keyless JSON downloads.",
    },
    {
      q: 'Can I use the ETF database?',
      a: 'Yes — it is served keyless as JSON and powers the ETF Intelligence page. Attribution appreciated but not required.',
    },
    {
      q: 'Where does the data come from?',
      a: "Public fund disclosures aggregated into a single JSON file, refreshed as allocations change. The SEO audit is generated by the site's own crawler.",
    },
  ]}
>
  <Nav />
  <main id="main-content" class="pt-32">
    <section class="py-16 px-6 md:px-12 lg:px-24">
      <p class="label mb-6 cinematic-enter" style="color: var(--accent);">WORLD DATA</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4 cinematic-enter cinematic-enter-delay-1">Reference Datasets</h1>
      <p class="text-lg cinematic-enter cinematic-enter-delay-2" style="color: var(--text-secondary); max-width: 640px;">
        The machine-readable files powering the dashboards — keyless JSON, free to download, no authentication.
      </p>
    </section>

    <section class="py-8 px-6 md:px-12 lg:px-24 space-y-4 pb-24">
      <div class="border p-6" style="border-color: var(--border); background: var(--bg-card);">
        <p class="label mb-2" style="color: var(--accent);">DATASET 01</p>
        <h2 class="text-xl font-bold mb-2">ETF Database</h2>
        <p class="text-sm mb-4" style="color: var(--text-secondary);">
          89 funds with ticker, name, category, sector allocation, region allocation, and top holdings.
          Powers the <a href="/etf" class="hover:underline" style="color: var(--accent);">ETF Intelligence</a> page.
        </p>
        <a href="/data/etf-database.json" class="font-mono text-xs hover:underline" style="color: var(--accent);">GET /data/etf-database.json ↗</a>
      </div>

      <div class="border p-6" style="border-color: var(--border); background: var(--bg-card);">
        <p class="label mb-2" style="color: var(--accent);">DATASET 02</p>
        <h2 class="text-xl font-bold mb-2">SEO Audit (site-wide)</h2>
        <p class="text-sm mb-4" style="color: var(--text-secondary);">
          The site crawling itself: pages crawled, issues, warnings, passes, category scores, and
          recommendations from the last audit run.
        </p>
        <a href="/data/seo-audit.json" class="font-mono text-xs hover:underline" style="color: var(--accent);">GET /data/seo-audit.json ↗</a>
      </div>

      <div class="border p-6" style="border-color: var(--border); background: var(--bg-card);">
        <p class="label mb-2" style="color: var(--accent);">DATASET 03</p>
        <h2 class="text-xl font-bold mb-2">SEO Per-Page Metrics</h2>
        <p class="text-sm mb-4" style="color: var(--text-secondary);">
          Per-URL metrics — status, title/description lengths, h1 count, word count, fetch time, issues.
        </p>
        <a href="/data/seo-pages.json" class="font-mono text-xs hover:underline" style="color: var(--accent);">GET /data/seo-pages.json ↗</a>
      </div>

      <div class="border p-6" style="border-color: var(--accent); background: var(--bg-card);">
        <p class="label mb-2" style="color: var(--accent);">DATA STUDY</p>
        <h2 class="text-xl font-bold mb-2">ETF allocation & concentration</h2>
        <p class="text-sm mb-4" style="color: var(--text-secondary);">
          Built from this dataset: sector exposures, top-holding ubiquity, and
          category tilts across all 89 funds — recomputed at build time.
        </p>
        <a href="/insights/etf-allocation-study" class="font-mono text-xs hover:underline" style="color: var(--accent);">Read the study ↗</a>
      </div>

      <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
    </section>
  </main>
  <Footer />
</BaseLayout>
