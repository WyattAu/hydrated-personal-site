---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import '../styles/base.css';
import '../styles/animations.css';

import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const allTechnologies = [...new Set(allProjects.flatMap((p) => p.data.technologies))].sort();
---

<BaseLayout title="Projects — Wyatt Au" description="Open-source projects and technical work by Wyatt Au.">
  <Nav />

  <main id="main-content" class="pt-24">
    <section class="py-16 px-6 md:px-12 lg:px-24">
      <p class="label mb-6 cinematic-enter" style="color: var(--accent);">PROJECTS</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4 cinematic-enter cinematic-enter-delay-1">Projects</h1>
      <p class="text-lg cinematic-enter cinematic-enter-delay-2" style="color: var(--text-secondary); max-width: 640px;">
        Open-source projects, tools, and experiments. Filter by language or sort by criteria.
      </p>
    </section>

    <!-- Filters -->
    <section class="px-6 md:px-12 lg:px-24 pb-8">
      <div class="flex flex-wrap gap-3 items-center reveal">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider" style="color: var(--accent);">Filter:</span>
        <button
          class="project-filter font-mono text-[10px] px-3 py-1.5 border uppercase tracking-wider transition-all"
          data-filter="all"
          style="border-color: var(--accent); color: var(--accent); background: rgba(0, 229, 255, 0.1);"
        >
          All ({allProjects.length})
        </button>
        {allTechnologies.map((tech) => (
          <button
            class="project-filter font-mono text-[10px] px-3 py-1.5 border uppercase tracking-wider transition-all"
            data-filter={tech}
            style="border-color: var(--border); color: var(--text-secondary);"
          >
            {tech}
          </button>
        ))}
      </div>

      <div class="flex gap-3 mt-4 items-center reveal">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider" style="color: var(--accent);">Sort:</span>
        <button
          class="project-sort font-mono text-[10px] px-3 py-1.5 border uppercase tracking-wider transition-all active"
          data-sort="order"
          style="border-color: var(--accent); color: var(--accent); background: rgba(0, 229, 255, 0.1);"
        >
          Featured
        </button>
        <button
          class="project-sort font-mono text-[10px] px-3 py-1.5 border uppercase tracking-wider transition-all"
          data-sort="title"
          style="border-color: var(--border); color: var(--text-secondary);"
        >
          A → Z
        </button>
      </div>
    </section>

    <!-- Project Grid -->
    <section class="py-8 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children reveal">
        {allProjects.map((project) => (
          <a
            href={project.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card amoebic-morph block p-6 border"
            style="border-color: var(--border); background: var(--bg-card); text-decoration: none;"
            data-technologies={project.data.technologies.join(',')}
            data-title={project.data.title}
            data-order={project.data.order}
          >
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-mono text-sm font-bold" style="color: var(--text-primary);">
                {project.data.title}
              </h3>
              {project.data.featured && (
                <span class="font-mono text-[9px] font-bold uppercase tracking-widest px-2 py-0.5" style="background: var(--accent); color: var(--bg-primary);">
                  Featured
                </span>
              )}
            </div>
            <p class="text-sm mb-4" style="color: var(--text-secondary);">
              {project.data.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.data.technologies.map((tech) => (
                <span class="font-mono text-[10px] px-2 py-0.5" style="border: 1px solid var(--border); color: var(--accent);">
                  {tech}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('.reveal, .stagger-children').forEach((el) => observer.observe(el));

    // Project filtering
    let activeFilter = 'all';
    let activeSort = 'order';

    function applyFilters() {
      const cards = document.querySelectorAll<HTMLElement>('.project-card');
      cards.forEach((card) => {
        const techs = card.dataset.technologies?.split(',') || [];
        const match = activeFilter === 'all' || techs.includes(activeFilter);
        card.style.display = match ? '' : 'none';
      });

      const grid = document.getElementById('project-grid');
      if (!grid) return;
      const visible = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'))
        .filter((c) => c.style.display !== 'none');

      visible.sort((a, b) => {
        if (activeSort === 'title') {
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
        return parseInt(a.dataset.order || '0') - parseInt(b.dataset.order || '0');
      });

      visible.forEach((card) => grid.appendChild(card));
    }

    document.querySelectorAll('.project-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'all';
        document.querySelectorAll('.project-filter').forEach((b) => {
          b.style.borderColor = 'var(--border)';
          b.style.color = 'var(--text-secondary)';
          b.style.background = '';
        });
        btn.style.borderColor = 'var(--accent)';
        btn.style.color = 'var(--accent)';
        btn.style.background = 'rgba(0, 229, 255, 0.1)';
        applyFilters();
      });
    });

    document.querySelectorAll('.project-sort').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeSort = btn.getAttribute('data-sort') || 'order';
        document.querySelectorAll('.project-sort').forEach((b) => {
          b.style.borderColor = 'var(--border)';
          b.style.color = 'var(--text-secondary)';
          b.style.background = '';
        });
        btn.style.borderColor = 'var(--accent)';
        btn.style.color = 'var(--accent)';
        btn.style.background = 'rgba(0, 229, 255, 0.1)';
        applyFilters();
      });
    });
  </script>
</BaseLayout>
