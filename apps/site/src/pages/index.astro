---
import Footer from '../components/astro/Footer.astro';
import Nav from '../components/astro/Nav.astro';
import CommandPalette from '../components/solid/CommandPalette';
import ContactForm from '../components/solid/ContactForm';
import AppErrorBoundary from '../components/solid/ErrorBoundary';
import ThemeToggle from '../components/solid/ThemeToggle';
import TickerBar from '../components/solid/TickerBar';
import ToasterWrapper from '../components/solid/ToasterWrapper';
import Counter from '../components/solid/fx/Counter';
import DecryptedText from '../components/solid/fx/DecryptedText';
import Magnet from '../components/solid/fx/Magnet';
import SiteDock from '../components/solid/fx/SiteDock';
import SpotlightCard from '../components/solid/fx/SpotlightCard';
import StarBorder from '../components/solid/fx/StarBorder';
import TechLoop from '../components/solid/fx/TechLoop';
import ThemeAurora from '../components/solid/fx/ThemeAurora';
import ThemeDotField from '../components/solid/fx/ThemeDotField';
import ThemeElectricBorder from '../components/solid/fx/ThemeElectricBorder';
import LiveTicker from '../components/solid/quant/LiveTicker';
import PortfolioBacktest from '../components/solid/quant/PortfolioBacktest';
import VolSurface from '../components/solid/quant/VolSurface';
import FourierDemo from '../components/solid/showcase/FourierDemo';
import WasmEmbed from '../components/wasm/WasmEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/base.css';
import '../styles/animations.css';

import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const expertiseCategories = [
  { title: 'Systems Programming', items: 'Rust, C++, C, Lean 4, WASM', icon: '{ }' },
  { title: 'Web Assembly', items: 'Leptos, wasm-pack, WASM sandboxing', icon: '<>' },
  {
    title: 'Infrastructure',
    items: 'Docker, Kubernetes, Cloudflare, Terraform, Nix Flakes',
    icon: '::',
  },
  {
    title: 'Data Engineering',
    items: 'PostgreSQL, TimescaleDB, Redis, Prometheus + Grafana',
    icon: '##',
  },
  { title: 'Security', items: 'Bubblewrap isolation, CSP headers, Keycloak IAM', icon: '[]' },
  { title: 'UI/UX', items: 'SolidJS, Flutter, Brutalist design, Theme systems', icon: '//' },
];

const employment = [
  {
    role: 'Founder & Backend Engineer',
    company: 'QuestHive',
    duration: 'Jun 2025 — Present',
    description:
      'Bootstrapping an early-stage SaaS platform focused on infrastructure automation. Responsible for system architecture, interfacing services, and deployment pipelines.',
    highlights: ['System architecture', 'CI/CD pipelines', 'Cloudflare Workers deployment'],
  },
  {
    role: 'Freelance Developer',
    company: 'Self-Employed',
    duration: '2022 — 2025',
    description:
      'Delivered full-stack solutions for clients including web applications, mobile apps, and infrastructure automation.',
    highlights: ['Full-stack web apps', 'Mobile applications', 'Infrastructure automation'],
  },
];
---

<BaseLayout>
  <Nav />

  <main id="main-content" class="pt-14">
    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center px-6 md:px-12 lg:px-24 relative">
      <!-- Hero background images (AVIF primary, WebP fallback) -->
      <div class="hero-images" aria-hidden="true">
        <picture>
          <source srcset="/images/london_night.avif" type="image/avif" />
          <source srcset="/images/london_night.webp" type="image/webp" />
          <img src="/images/london_night.webp" alt="London cityscape at night with illuminated buildings and river reflections" loading="eager" fetchpriority="high" class="hero-img hero-img-left" />
        </picture>
        <picture>
          <source srcset="/images/hong_kong_twilight.avif" type="image/avif" />
          <source srcset="/images/hong_kong_twilight.webp" type="image/webp" />
          <img src="/images/hong_kong_twilight.webp" alt="Hong Kong skyline at twilight with city lights reflecting on Victoria Harbour" loading="eager" fetchpriority="high" class="hero-img hero-img-right" />
        </picture>
      </div>
      <div class="hero-overlay"></div>
      <ThemeAurora client:load class="absolute inset-x-0 top-0 z-[1] pointer-events-none opacity-70" />
      <ThemeDotField client:load class="absolute inset-0 z-[2] pointer-events-none opacity-60" />

      <div class="max-w-4xl relative z-10">
        <p class="label mb-4 cinematic-enter" style="color: var(--accent);">WYATT AU</p>

        <h1 class="hero-name mb-4 cinematic-enter cinematic-enter-delay-1" style="font-family: var(--font-display, 'Fraunces', Georgia, serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 600; letter-spacing: -0.02em;">
          <span id="rotating-title">Full Stack Engineer</span><span class="type-cursor" aria-hidden="true"></span>
        </h1>

        <p class="text-lg md:text-xl mb-8 cinematic-enter cinematic-enter-delay-2" style="color: rgba(238, 242, 247, 0.85); max-width: 640px;">
          Building deterministic infrastructure and high-performance systems.
          Currently bootstrapping QuestHive.
        </p>

        <p class="code-text mb-10 cinematic-enter cinematic-enter-delay-3" style="color: rgba(238, 242, 247, 0.75);">
          United Kingdom // <a href="mailto:wyatt_au@protonmail.com" class="hover:underline" style="color: var(--accent);">wyatt_au@protonmail.com</a>
        </p>

        <ThemeElectricBorder
          client:load
          desktopOnly
          class="inline-block p-4 cinematic-enter cinematic-enter-delay-4"
          borderRadius={12}
        >
        <div class="flex gap-4 flex-wrap">
          <Magnet magnetStrength={2} maxOffset={6} padding={16}>
          <a
            href="https://github.com/WyattAu"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta amoeba-hover px-4 py-2 border text-xs font-mono uppercase tracking-widest"
          >
            GitHub
          </a>
          </Magnet>
          <Magnet magnetStrength={2} maxOffset={6} padding={16}>
          <a
            href="https://forgejo.wyattau.com/wyatt_admin"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta amoeba-hover px-4 py-2 border text-xs font-mono uppercase tracking-widest"
          >
            Forgejo
          </a>
          </Magnet>
          <Magnet magnetStrength={2} maxOffset={6} padding={16}>
          <a
            href="https://x.com/_WyattAu_"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta amoeba-hover px-4 py-2 border text-xs font-mono uppercase tracking-widest"
          >
            X / Twitter
          </a>
          </Magnet>
          <a
            href="https://ocis.wyattau.com/s/RvJsRemvgLYnuIh"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta amoeba-hover px-4 py-2 border text-xs font-mono uppercase tracking-widest"
          >
            CV
          </a>
        </div>
        </ThemeElectricBorder>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
        <span
          class="label block text-center breathe"
          style="color: var(--text-secondary);"
        >
          SCROLL ↓
        </span>
      </div>
    </section>


    <!-- Ticker Bar -->
    <section class="px-6 md:px-12 lg:px-24" style="border-top: 1px solid var(--border);">
      <TickerBar client:load />
    </section>

    <!-- Sys metrics + built-with marquee (retention band) -->
    <section class="py-10 px-6 md:px-12 lg:px-24 border-t reveal" style="border-color: var(--border);">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="border p-4" style="border-color: var(--border); background: var(--bg-card);">
          <Counter client:visible value={16} duration={1400} class="font-mono text-2xl font-bold" style={{ color: 'var(--accent)' }} />
          <p class="label mt-1" style="color: var(--text-secondary);">WASM WIDGETS</p>
        </div>
        <div class="border p-4" style="border-color: var(--border); background: var(--bg-card);">
          <Counter client:visible value={89} duration={1400} class="font-mono text-2xl font-bold" style={{ color: 'var(--accent)' }} />
          <p class="label mt-1" style="color: var(--text-secondary);">ETF DATABASE</p>
        </div>
        <div class="border p-4" style="border-color: var(--border); background: var(--bg-card);">
          <Counter client:visible value={8} duration={1400} class="font-mono text-2xl font-bold" style={{ color: 'var(--accent)' }} />
          <p class="label mt-1" style="color: var(--text-secondary);">LIVE DATA FEEDS</p>
        </div>
        <div class="border p-4" style="border-color: var(--border); background: var(--bg-card);">
          <Counter client:visible value={5} duration={1400} class="font-mono text-2xl font-bold" style={{ color: 'var(--accent)' }} />
          <p class="label mt-1" style="color: var(--text-secondary);">SITE THEMES</p>
        </div>
      </div>
      <TechLoop client:visible />
    </section>

    <!-- About -->
    <section class="py-24 px-6 md:px-12 lg:px-24 border-t reveal" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);">001 — ABOUT</p>
      <div class="max-w-3xl">
        <h2 class="text-2xl md:text-3xl font-bold mb-6">Systems thinker, infrastructure builder.</h2>
        <p class="mb-4" style="color: var(--text-secondary);">
          UK-based backend and DevOps engineer with 6 years of experience building reproducible infrastructure,
          CI/CD pipelines, and high-performance systems. I architect solutions that stay standing after the next
          "must-have feature" ships to production.
        </p>
        <p class="mb-4" style="color: var(--text-secondary);">
          My work spans distributed systems, real-time data pipelines, developer experience tooling,
          and security-focused sandboxing. I believe in deterministic builds, modular architecture,
          and infrastructure that can be reasoned about.
        </p>
        <p style="color: var(--text-secondary);">
          Currently focused on WebAssembly-powered developer tools and infrastructure automation through QuestHive.
          When not shipping code, I'm probably debugging a CI pipeline or contributing to open-source projects
          that solve real problems.
        </p>
      </div>
    </section>

    <!-- Featured Projects -->
    <section id="projects" class="py-24 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);"><DecryptedText client:load text="002 — FEATURED PROJECTS" speed={30} class="text-current" /></p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children reveal">
        {allProjects.map((project) => (
          <SpotlightCard
            client:load
            class="p-0 rounded-lg"
            style={{ background: 'var(--bg-card)' }}
            spotlightColor="var(--accent)"
            spotlightSize={280}
          >
          <a
            href={project.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="amoebic-morph block p-6 border"
            style="border-color: var(--border); background: var(--bg-card); text-decoration: none;"
          >
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-mono text-sm font-bold" style="color: var(--text-primary);">{project.data.title}</h3>
              {project.data.featured && (
                <span class="font-mono text-[9px] font-bold uppercase tracking-widest px-2 py-0.5" style="background: var(--accent); color: var(--bg-primary);">
                  Featured
                </span>
              )}
            </div>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{project.data.description}</p>
            <p class="code-text" style="color: var(--accent);">{project.data.technologies.join(' · ')}</p>
          </a>
          </SpotlightCard>
        ))}
      </div>
      <div class="mt-8 reveal">
        <a
          href="/projects"
          class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider border"
          style="border-color: var(--border); color: var(--text-secondary);"
        >
          View All Projects →
        </a>
      </div>
    </section>

    <!-- WASM Showcase -->
    <section class="py-24 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);"><DecryptedText client:load text="003 — WASM SHOWCASE" speed={30} class="text-current" /></p>
      <h2 class="text-2xl md:text-3xl font-bold mb-4 reveal">Interactive Demonstrations</h2>
      <p class="mb-8 reveal" style="color: var(--text-secondary); max-width: 640px;">
        Real-time, client-side computations powered by WebAssembly. No server round-trips.
      </p>
      <!-- Live interactive showcase (glass cards) -->
      <StarBorder client:load color="var(--accent)" thickness={1} class="reveal mb-6">
      <div class="glass-card mb-6 reveal">
        <p class="section-label">LIVE — BINANCE WS</p>
        <LiveTicker client:load />
      </div>
      </StarBorder>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children reveal">
        <div class="glass-card">
          <p class="section-label">SVI VOL SURFACE</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Quasi-explicit SVI calibration from live Deribit option chains. Computed in WASM.</p>
          <VolSurface client:load />
        </div>
        <div class="glass-card">
          <p class="section-label">WALK-FORWARD BACKTEST</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Three strategies. Fitted per window. Net of slippage and commission. No look-ahead.</p>
          <PortfolioBacktest client:load />
        </div>
        <div class="glass-card md:col-span-2 lg:col-span-3">
          <p class="section-label">FOURIER SERIES — TIME VS FREQUENCY</p>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Partial sums S_N(t) converge to the target waveform while the magnitude spectrum |c_n| traces a continuous analytic envelope. Drag the harmonic count and watch Gibbs overshoot persist at discontinuities.</p>
          <FourierDemo client:visible />
        </div>
      </div>
    </section>

    <!-- Expertise Grid -->
    <section class="py-24 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);"><DecryptedText client:load text="004 — EXPERTISE" speed={30} class="text-current" /></p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 stagger-children reveal">
        {expertiseCategories.map((cat) => (
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="font-mono text-xs px-2 py-1" style="background: var(--bg-card); color: var(--accent); border: 1px solid var(--border);">
                {cat.icon}
              </span>
              <h3 class="font-mono text-xs font-bold uppercase tracking-wider" style="color: var(--accent);">{cat.title}</h3>
            </div>
            <p class="text-sm" style="color: var(--text-secondary);">{cat.items}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Employment Timeline -->
    <section class="py-24 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);"><DecryptedText client:load text="005 — EMPLOYMENT" speed={30} class="text-current" /></p>
      <div class="max-w-3xl stagger-children reveal">
        {employment.map((job, i) => (
          <div class={i < employment.length - 1 ? 'mb-12' : ''}>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-1 gap-1">
              <h3 class="font-mono text-sm font-bold">{job.role}</h3>
              <span class="code-text" style="color: var(--text-secondary);">{job.duration}</span>
            </div>
            <p class="text-sm mb-2" style="color: var(--accent);">{job.company}</p>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{job.description}</p>
            <div class="flex flex-wrap gap-2">
              {job.highlights.map((h) => (
                <span class="font-mono text-[10px] px-2 py-1" style="border: 1px solid var(--border); color: var(--text-secondary);">
                  {h}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section class="py-24 px-6 md:px-12 lg:px-24 border-t" style="border-color: var(--border);">
      <p class="label mb-6" style="color: var(--accent);"><DecryptedText client:load text="006 — CONTACT" speed={30} class="text-current" /></p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 reveal">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Get in touch.</h2>
          <p style="color: var(--text-secondary);" class="mb-6">
            Open to collaborations on high-performance systems, infrastructure tooling,
            and developer experience projects.
          </p>
          <div class="flex flex-col gap-3 mb-8">
            <a
              href="mailto:wyatt_au@protonmail.com"
              class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider text-center"
              style="background: var(--accent); color: var(--bg-primary);"
            >
              Email
            </a>
            <a
              href="https://github.com/WyattAu"
              target="_blank"
              rel="noopener noreferrer"
              class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider border text-center"
              style="border-color: var(--border); color: var(--text-secondary);"
            >
              GitHub
            </a>
            <a
              href="https://forgejo.wyattau.com/wyatt_admin"
              target="_blank"
              rel="noopener noreferrer"
              class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider border text-center"
              style="border-color: var(--border); color: var(--text-secondary);"
            >
              Forgejo
            </a>
            <a
              href="https://x.com/_WyattAu_"
              target="_blank"
              rel="noopener noreferrer"
              class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider border text-center"
              style="border-color: var(--border); color: var(--text-secondary);"
            >
              X / Twitter
            </a>
          </div>
        </div>
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-wider mb-4" style="color: var(--accent);">Send a Message</p>
          <AppErrorBoundary client:load>
            <ContactForm client:load />
          </AppErrorBoundary>
        </div>
      </div>
    </section>
  </main>

  <SiteDock client:load />
  <Footer />

  <ThemeToggle client:load />
  <CommandPalette client:load />
  <ToasterWrapper client:load />

  <style>
    .type-cursor {
      display: inline-block;
      width: 2px;
      height: 1em;
      margin-left: 2px;
      background: var(--accent);
      animation: blink 0.8s step-end infinite;
      vertical-align: baseline;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .ticker-strip {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      border-top: 1px solid var(--glass-border, rgba(201,168,108,0.12));
      background: var(--glass-bg, rgba(16,24,40,0.72));
      backdrop-filter: blur(8px);
      padding: 8px 24px;
      overflow: hidden;
      z-index: 20;
    }
  </style>
  <script>
    // Hero image pan animation — start after images load
    (function () {
      var imgs = document.querySelectorAll<HTMLImageElement>('.hero-img-left, .hero-img-right');
      var loaded = 0;
      var started = false;
      function start() {
        if (started) return;
        loaded++;
        if (loaded >= imgs.length) {
          setTimeout(function () {
            started = true;
            imgs.forEach(function (img) { img.classList.add('animate'); });
          }, 2000);
        }
      }
      imgs.forEach(function (img) {
        if (img.complete) start();
        else {
          img.addEventListener('load', start, { once: true });
          img.addEventListener('error', start, { once: true });
        }
      });
      // Fallback: force start after 5s
      setTimeout(function () {
        if (!started) {
          started = true;
          imgs.forEach(function (img) { img.classList.add('animate'); });
        }
      }, 5000);
    })();

    // Scroll reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('.reveal, .stagger-children').forEach((el) => observer.observe(el));
  
    // Rotating hero titles
    const titles = [
      'Full Stack Engineer',
      'DevOps Engineer',
      'SEO Engineer',
      'Systems Engineer',
      'Data Analyst',
    ];
    const el = document.getElementById('rotating-title');
    if (el) {
      let ti = 0, ci = 0, deleting = false;
      const type = () => {
        const word = titles[ti];
        if (!deleting) {
          ci++;
          el.textContent = word.slice(0, ci);
          if (ci >= word.length) { deleting = true; setTimeout(type, 2000); return; }
          setTimeout(type, 60);
        } else {
          ci--;
          el.textContent = word.slice(0, ci);
          if (ci <= 0) { deleting = false; ti = (ti + 1) % titles.length; setTimeout(type, 400); return; }
          setTimeout(type, 30);
        }
      };
      setTimeout(type, 800);
    }
    </script>
