---
import { getCollection, render } from 'astro:content';
import Footer from '../components/astro/Footer.astro';
import Nav from '../components/astro/Nav.astro';
import ThemeToggle from '../components/solid/ThemeToggle';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/base.css';
import '../styles/animations.css';

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const renderedDocs = await Promise.all(
  allDocs.map(async (doc) => {
    const { Content } = await render(doc);
    return {
      id: doc.id,
      title: doc.data.title,
      description: doc.data.description,
      Content,
    };
  }),
);
---

<BaseLayout title="Docs — Wyatt Au" description="Technical notes, architecture decisions, and infrastructure documentation.">
  <Nav />
  <ThemeToggle client:load />

  <main class="min-h-screen px-6 md:px-12 lg:px-24 pt-32 pb-12 max-w-7xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar -->
      <aside class="lg:w-64 shrink-0">
        <p class="label mb-4" style="color: var(--accent);">DOCS</p>
        <nav class="flex flex-col gap-1">
          {renderedDocs.map((doc, i) => (
            <a
              href={`#${doc.slug}`}
              class="font-mono text-xs uppercase tracking-wider px-3 py-2 border transition-colors amoebic-morph"
              style="border-color: var(--border); color: var(--text-secondary);"
              data-doc-index={i}
            >
              {String(i + 1).padStart(2, '0')} {doc.title}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Content -->
      <div class="flex-1 min-w-0 max-w-4xl">
        <h1 class="hero-name mb-8" style="font-size: 2rem;">Documentation</h1>
        <div class="flex flex-col gap-12">
          {renderedDocs.map((doc) => (
            <article id={doc.id} class="scroll-mt-20">
              <h2 class="font-mono text-xl font-bold mb-2" style="color: var(--accent);">
                {doc.title}
              </h2>
              <p class="text-sm mb-4" style="color: var(--text-secondary);">
                {doc.description}
              </p>
              <div class="prose prose-invert max-w-none docs-content"><doc.Content /></div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .docs-content :global(h2) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .docs-content :global(h3) {
    font-size: 1rem;
    color: var(--text-primary);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
  .docs-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
  .docs-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    background: var(--bg-secondary);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border);
  }
  .docs-content :global(pre) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    background: var(--bg-secondary);
    padding: 1rem;
    border: 1px solid var(--border);
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .docs-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }
  .docs-content :global(ul),
  .docs-content :global(ol) {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .docs-content :global(li) {
    margin-bottom: 0.25rem;
  }
  .docs-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem;
    text-align: left;
    font-size: 0.8rem;
  }
  .docs-content :global(th) {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }
</style>
