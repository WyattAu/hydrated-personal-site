---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404, Not Found" description="Page not found.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="text-center max-w-lg">
      <p class="text-7xl md:text-8xl font-semibold mb-6" style="font-family: var(--font-display, 'Fraunces', Georgia, serif); color: var(--accent);">404</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--text-primary);">This page doesn't exist.</h1>
      <p class="mb-8" style="color: var(--text-secondary);">
        The address is wrong or the page moved. Everything published lives
        under these doors:
      </p>
      <div class="flex gap-3 justify-center flex-wrap mb-10">
        <a href="/" class="px-5 py-2.5 border text-sm hover:underline" style="border-color: var(--border); color: var(--text-primary);">Home</a>
        <a href="/projects" class="px-5 py-2.5 border text-sm hover:underline" style="border-color: var(--border); color: var(--text-primary);">Projects</a>
        <a href="/insights" class="px-5 py-2.5 border text-sm hover:underline" style="border-color: var(--border); color: var(--text-primary);">Insights</a>
        <a href="/data" class="px-5 py-2.5 border text-sm hover:underline" style="border-color: var(--border); color: var(--text-primary);">Data</a>
      </div>
    </div>
  </main>
</BaseLayout>
