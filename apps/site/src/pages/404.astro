---
import '../styles/base.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="Page not found.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="text-center">
      <p class="stat-value mb-4" style="color: var(--accent);">404</p>
      <div class="font-mono text-sm mb-8" style="color: var(--text-secondary);">
        <span style="color: var(--accent);">$</span> find / —name "this_page" 2>/dev/null<br />
        <span style="color: var(--text-secondary);">find: no results found</span>
      </div>
      <p class="mb-8" style="color: var(--text-secondary);">The page you are looking for does not exist.</p>
      <a
        href="/"
        class="amoeba-hover inline-block px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider"
        style="background: var(--accent); color: var(--bg-primary);"
      >
        Return Home
      </a>
    </div>
  </main>
</BaseLayout>
