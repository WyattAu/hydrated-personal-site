  "/guestbook": {
   "get": {
    "summary": "List guestbook entries",
    "responses": {
     "200": {
      "description": "Entries"
     }
    }
   },
   "post": {
    "summary": "Sign the guestbook",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "name",
         "message"
        ],
        "properties": {
         "name": {
          "type": "string",
          "maxLength": 50
         },
         "message": {
          "type": "string",
          "maxLength": 500
         },
         "website": {
          "type": "string"
         }
        }
       }
      }
     },
     "responses": {
      "200": {
       "description": "Signed"
      },
      "400": {
       "description": "Invalid input"
      },
      "429": {
       "description": "Rate limited"
      }
     }
    }
   },
   "delete": {
    "summary": "Delete own entry (authenticated)",
    "responses": {
     "200": {
      "description": "Deleted"
     }
    }
   }
