      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "502": {
      "description": "Upstream unavailable (circuit breaker open; stale cache served when available)"
     },
     "429": {
      "description": "Rate limited"
     }
    }
   }
  },
