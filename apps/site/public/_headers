/*
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.cloudflare.com https://www.deribit.com https://api.binance.com https://api.github.com https://hn.algolia.com https://nominatim.openstreetmap.org https://tile.openstreetmap.org https://a.basemaps.cartocdn.com https://b.basemaps.cartocdn.com https://c.basemaps.cartocdn.com https://d.basemaps.cartocdn.com https://api.frankfurter.app https://earthquake.usgs.gov https://services.swpc.noaa.gov https://api.alternative.me wss://stream.binance.com:9443; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization

/wasm/*
  Cache-Control: public, max-age=3600, must-revalidate
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# RFC 9727 api-catalog: linkset+json content type
/.well-known/api-catalog
  Content-Type: application/linkset+json
/.well-known/agent-card.json
  Content-Type: application/json
/.well-known/agent-skills/index.json
  Content-Type: application/json
/auth.md
  Content-Type: text/markdown; charset=utf-8

# RFC 8288 Link headers: agent discovery surfaces (sitewide)
/*
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="describedby", </auth.md>; rel="service-doc", </.well-known/agent-card.json>; rel="service-desc", </markdown/index.md>; rel="alternate"; type="text/markdown"

/markdown/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
